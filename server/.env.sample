# Environment (development | production)
ENVIRONMENT=development

# Vector DB Config
CHROMA_PERSIST_DIR=my_chroma_db

# Redis Config
REDIS_URL=redis://localhost:6379/0

# MySQL Database Config
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DB=collage_db

# JWT Auth Config
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_ACCESS_TOKEN_EXPIRE_DAYS=7

# Embeddings Config
OLLAMA_EMBEDDING_MODEL=your_ollama_embedding_model
GEMINI_EMBEDDING_MODEL=your_gemini_embedding_model
GOOGLE_API_KEY=your_gemini_api_key_here

# Generation LLM Config
OLLAMA_LLM_MODEL=llama3.2
GEMINI_LLM_MODEL=gemini-1.5-flash

# Ingestion & Chunking Config
CHUNK_SIZE=512
CHUNK_OVERLAP=100
IMAGE_OUTPUT_DIR=storage/images

HUGGINGFACEHUB_API_TOKEN=
HF_TOKEN=

# LangSmith Debugging & Tracing Config
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=collage-rag
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

